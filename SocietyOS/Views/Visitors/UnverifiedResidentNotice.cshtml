@{
    ViewData["Title"] = "Flat Verification Required";
}

<div class="home-container" style="max-width: 480px; text-align: center; padding-top: 40px;">
    <div style="font-size: 48px; margin-bottom: 12px;">🛡️</div>
    <h3 class="fw-bold mb-2">Flat Verification Pending</h3>
    <p class="text-muted" style="font-size: 14px; line-height: 1.5; margin-bottom: 24px;">
        Your SocietyOS account is not yet linked to a verified flat. For resident safety and privacy, incoming visitor notifications and gate requests are restricted until an administrator verifies your unit.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success px-4 py-2" style="border-radius: var(--sos-radius-full);">
        Return to Home Screen
    </a>
</div>