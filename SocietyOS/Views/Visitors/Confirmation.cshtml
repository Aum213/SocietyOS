@model SocietyOS.ViewModels.VisitorConfirmationViewModel
@{
    ViewData["Title"] = "Visitor Request Created";
}

@section Styles {
    <link rel="stylesheet" href="~/css/societyos-home.css" asp-append-version="true" />
}

<div class="home-container" style="max-width: 520px; text-align: center; padding-top: 30px;">
    <div style="width: 64px; height: 64px; border-radius: 50%; background: #eef8f2; color: #1e4d38; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </div>

    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 6px;">Request Dispatched</h2>
    <p class="text-muted" style="font-size: 14px; margin-bottom: 24px;">The resident has received the approval prompt on their SocietyOS app.</p>

    <div style="background: #ffffff; border: 1px solid var(--sos-border); border-radius: var(--sos-radius-lg); padding: 20px; text-align: left; box-shadow: var(--sos-shadow-card); margin-bottom: 24px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted" style="font-size: 12px; font-weight: 600;">PASS REFERENCE</span>
            <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 12px;">Pending Approval</span>
        </div>

        <div style="font-size: 18px; font-weight: 700; color: var(--sos-primary); margin-bottom: 12px;">
            @Model.VisitorName
        </div>

        <div class="row g-2" style="font-size: 13px;">
            <div class="col-6">
                <span class="text-muted d-block" style="font-size: 11px;">DESTINATION</span>
                <strong>@Model.FlatDisplay (@Model.BuildingName)</strong>
            </div>
            <div class="col-6">
                <span class="text-muted d-block" style="font-size: 11px;">PURPOSE</span>
                <strong>@Model.Purpose</strong>
            </div>
            <div class="col-6 mt-2">
                <span class="text-muted d-block" style="font-size: 11px;">ACCOMPANYING</span>
                <strong>@(Model.AccompanyingPersons == 0 ? "Solo Visitor" : $"+{Model.AccompanyingPersons} Persons")</strong>
            </div>
            <div class="col-6 mt-2">
                <span class="text-muted d-block" style="font-size: 11px;">AUTO-PURGE EXPIRES</span>
                <strong>@Model.ExpiresAtUtc.ToString("dd MMM, HH:mm") UTC</strong>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Register" class="btn btn-success flex-grow-1 py-2 fw-bold" style="border-radius: var(--sos-radius-full); background: var(--sos-primary); border-color: var(--sos-primary);">
            Register Next Visitor
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary py-2" style="border-radius: var(--sos-radius-full);">
            Home
        </a>
    </div>
</div>