@model SocietyOS.ViewModels.VisitorCardViewModel
@{
    ViewData["Title"] = "Visitor Details — " + Model.VisitorName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/societyos-home.css" asp-append-version="true" />
}

<div class="home-container" style="max-width: 520px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="fw-bold m-0" style="font-size: 20px;">Visitor Profile</h3>
        <a asp-action="Pending" class="btn btn-sm btn-outline-secondary" style="border-radius: var(--sos-radius-full);">
            Back to Inbox
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
        <div style="height: 260px; background: #0f172a; display: flex; align-items: center; justify-content: center; position: relative;">
            <img src="@Url.Action("Photo", "Visitors", new { id = Model.Id })" style="width: 100%; height: 100%; object-fit: contain;" alt="Visitor photograph" />
            <span class="badge position-absolute top-0 end-0 m-3 px-3 py-2 @(Model.Status == SocietyOS.Models.VisitorStatus.Pending ? "bg-warning text-dark" : Model.Status == SocietyOS.Models.VisitorStatus.Approved ? "bg-success" : "bg-danger")" style="font-size: 12px;">
                @Model.Status
            </span>
        </div>

        <div class="card-body p-4">
            <h4 class="fw-bold text-success mb-2">@Model.VisitorName</h4>
            <p class="text-muted mb-3" style="font-size: 13px;">@Model.Purpose @(string.IsNullOrEmpty(Model.PurposeDetails) ? "" : $"— {Model.PurposeDetails}")</p>

            <div class="row g-3 py-3 border-top border-bottom mb-3" style="font-size: 13px;">
                <div class="col-6">
                    <span class="text-muted d-block" style="font-size: 11px;">ACCOMPANYING</span>
                    <strong>@(Model.AccompanyingPersons == 0 ? "Solo Visitor" : $"+{Model.AccompanyingPersons} Persons")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block" style="font-size: 11px;">ARRIVAL TIME</span>
                    <strong>@Model.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block" style="font-size: 11px;">REGISTERED BY</span>
                    <strong>@(Model.RegisteredByGuardName ?? "Gate Guard")</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block" style="font-size: 11px;">PRIVACY EXPIRY</span>
                    <strong class="text-danger">@Model.ExpiresAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</strong>
                </div>
            </div>

            @if (Model.Status == SocietyOS.Models.VisitorStatus.Pending)
            {
                <div class="d-flex gap-2">
                    <form asp-action="Decide" method="post" class="flex-grow-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RequestId" value="@Model.Id" />
                        <input type="hidden" name="Decision" value="Approve" />
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="border-radius: var(--sos-radius-full);">
                            Approve Entry
                        </button>
                    </form>

                    <form asp-action="Decide" method="post" class="flex-grow-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RequestId" value="@Model.Id" />
                        <input type="hidden" name="Decision" value="Reject" />
                        <button type="submit" class="btn btn-outline-danger w-100 py-2 fw-bold" style="border-radius: var(--sos-radius-full);">
                            Deny Entry
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="p-3 bg-light rounded-3 text-center" style="font-size: 12px; color: var(--sos-text-secondary);">
                    Decision recorded at <strong>@Model.DecisionAtUtc?.ToString("dd MMM, HH:mm") UTC</strong> @(string.IsNullOrEmpty(Model.DecidedBy) ? "" : $"by {Model.DecidedBy}").
                </div>
            }
        </div>
    </div>
</div>