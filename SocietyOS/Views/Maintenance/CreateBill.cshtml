@model SocietyOS.ViewModels.CreateBillsInputModel
@{
    ViewData["Title"] = "Generate Maintenance Bills";
}

<div class="home-container" style="max-width: 600px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge bg-dark mb-1" style="font-size: 10px;">ADMINISTRATION</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Generate Maintenance Bills</h2>
        </div>
        <a asp-action="Admin" class="btn btn-sm btn-outline-secondary rounded-pill">Cancel</a>
    </div>

    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <div class="alert alert-light border py-2 px-3 mb-3" style="font-size: 12px;">
            ✓ <strong>Duplicate-Safe Generation:</strong> Any flat that already has a bill for the selected month and year will be safely skipped without creating duplicates.
        </div>

        <form asp-action="CreateBill" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size: 13px;"></div>

            <div class="mb-3">
                <label asp-for="TargetScope" class="form-label fw-bold" style="font-size: 13px;"></label>
                <select asp-for="TargetScope" class="form-select" id="scopeSelect">
                    <option value="SingleFlat">Single Flat</option>
                    <option value="Building">All Flats in Selected Building / Tower</option>
                    <option value="AllSociety">All Flats Across Society (Towers A–D)</option>
                </select>
            </div>

            <div class="mb-3" id="flatWrap">
                <label asp-for="FlatId" class="form-label fw-bold" style="font-size: 13px;"></label>
                <select asp-for="FlatId" asp-items="Model.Flats" class="form-select"></select>
            </div>

            <div class="mb-3" id="buildingWrap" style="display: none;">
                <label asp-for="BuildingId" class="form-label fw-bold" style="font-size: 13px;"></label>
                <select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select"></select>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="BillingMonth" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <select asp-for="BillingMonth" class="form-select">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@(new DateTime(2026, m, 1).ToString("MMMM")) (@m)</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label asp-for="BillingYear" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <input asp-for="BillingYear" type="number" class="form-control" />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="IssueDateLocal" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <input asp-for="IssueDateLocal" type="date" class="form-control" />
                </div>
                <div class="col-6">
                    <label asp-for="DueDateLocal" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <input asp-for="DueDateLocal" type="date" class="form-control" />
                    <span asp-validation-for="DueDateLocal" class="text-danger" style="font-size: 11px;"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="AmountInr" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="AmountInr" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="AmountInr" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold rounded-pill" style="background: var(--sos-primary);">
                Confirm & Generate Bill(s)
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const scopeSelect = document.getElementById('scopeSelect');
        const flatWrap = document.getElementById('flatWrap');
        const buildingWrap = document.getElementById('buildingWrap');
        function syncScope() {
            flatWrap.style.display = scopeSelect.value === 'SingleFlat' ? 'block' : 'none';
            buildingWrap.style.display = scopeSelect.value === 'Building' ? 'block' : 'none';
        }
        scopeSelect?.addEventListener('change', syncScope);
        syncScope();
    </script>
}