@model List<SocietyOS.ViewModels.AmenityItemViewModel>
@{
    ViewData["Title"] = "Manage Amenities";
}

<div class="home-container" style="max-width: 820px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <span class="badge bg-dark mb-1" style="font-size: 10px;">ADMINISTRATION</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Manage Amenities</h2>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Bookings" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">All Resident Bookings</a>
            <a asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" style="background: var(--sos-primary);">+ Add Amenity</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3" style="font-size: 13px;">@TempData["SuccessMessage"]</div>
    }

    @foreach (var item in Model)
    {
        <div class="bg-white border rounded-4 p-3 mb-2 shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <div>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary") me-1" style="font-size: 10px;">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                    <strong style="font-size: 15px;">@item.Name</strong>
                    <span class="text-muted ms-1" style="font-size: 12px;">(@item.OperatingHoursDisplay)</span>
                </div>
                <span class="badge bg-light text-dark border" style="font-size: 11px;">
                    @item.UpcomingConfirmedCount Upcoming Booking(s)
                </span>
            </div>

            <p class="text-muted mb-2" style="font-size: 12px;">@item.Description</p>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3" style="font-size: 11px;">Edit Rules</a>
                <a asp-action="Closures" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3" style="font-size: 11px;">Maintenance Closures</a>

                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3" style="font-size: 11px;">
                        @(item.IsActive ? "Deactivate" : "Activate")
                    </button>
                </form>
            </div>
        </div>
    }
</div>