@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var isHome = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                 currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);
    var isGate = currentController.Equals("Visitors", StringComparison.OrdinalIgnoreCase);
    var isIssues = currentController.Equals("Issues", StringComparison.OrdinalIgnoreCase);
    var isMarket = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                   currentAction.Equals("Market", StringComparison.OrdinalIgnoreCase);
    var isMore = (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                  currentAction.Equals("More", StringComparison.OrdinalIgnoreCase)) ||
                 currentController.Equals("Announcements", StringComparison.OrdinalIgnoreCase);
}

<nav class="bottom-nav-bar" aria-label="Primary Bottom Navigation">
    <div class="bottom-nav-inner">
        <!-- 1. Home -->
        <a asp-area="" asp-controller="Home" asp-action="Index"
           class="nav-item-btn @(isHome ? "active" : "")"
           aria-current="@(isHome ? "page" : null)">
            @if (isHome)
            {
                <span class="nav-active-indicator" aria-hidden="true"></span>
            }
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Home</span>
        </a>

        <!-- 2. Gate (Role-resolved entry point on VisitorsController.Index) -->
        <a asp-area="" asp-controller="Visitors" asp-action="Index"
           class="nav-item-btn @(isGate ? "active" : "")"
           aria-current="@(isGate ? "page" : null)">
            @if (isGate)
            {
                <span class="nav-active-indicator" aria-hidden="true"></span>
            }
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Gate</span>
        </a>

        <!-- 3. Issues (Opens Community Issue Feed) -->
        <a asp-area="" asp-controller="Issues" asp-action="Index"
           class="nav-item-btn @(isIssues ? "active" : "")"
           aria-current="@(isIssues ? "page" : null)">
            @if (isIssues)
            {
                <span class="nav-active-indicator" aria-hidden="true"></span>
            }
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Issues</span>
        </a>

        <!-- 4. Market -->
        <a asp-area="" asp-controller="Home" asp-action="Market"
           class="nav-item-btn @(isMarket ? "active" : "")"
           aria-current="@(isMarket ? "page" : null)">
            @if (isMarket)
            {
                <span class="nav-active-indicator" aria-hidden="true"></span>
            }
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span>Market</span>
        </a>

        <!-- 5. More -->
        <a asp-area="" asp-controller="Home" asp-action="More"
           class="nav-item-btn @(isMore ? "active" : "")"
           aria-current="@(isMore ? "page" : null)">
            @if (isMore)
            {
                <span class="nav-active-indicator" aria-hidden="true"></span>
            }
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="19" cy="12" r="1"></circle>
                <circle cx="5" cy="12" r="1"></circle>
            </svg>
            <span>More</span>
        </a>
    </div>
</nav>