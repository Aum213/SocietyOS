@model SocietyOS.ViewModels.AdminDailyHelpFormViewModel
@using SocietyOS.Models
@using SocietyOS.Controllers
@{
    ViewData["Title"] = "Edit Daily Help Provider";
}

<div class="home-container" style="max-width: 600px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="m-0 fw-bold" style="font-size: 22px;">Edit Provider Listing</h2>
        <a asp-action="Admin" class="btn btn-sm btn-outline-secondary rounded-pill">Cancel</a>
    </div>

    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size: 13px;"></div>

            <div class="mb-3">
                <label asp-for="ProviderName" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="ProviderName" class="form-control" />
                <span asp-validation-for="ProviderName" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Category" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <select asp-for="Category" class="form-select">
                        @foreach (var cat in Enum.GetValues<DailyHelpCategory>())
                        {
                            <option value="@cat">@DailyHelpController.FormatCategoryLabel(cat)</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label asp-for="ContactPhone" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <input asp-for="ContactPhone" class="form-control" />
                    <span asp-validation-for="ContactPhone" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="ServiceArea" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <input asp-for="ServiceArea" class="form-control" />
                </div>
                <div class="col-6">
                    <label asp-for="AvailabilityNotes" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <input asp-for="AvailabilityNotes" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ExperienceNotes" class="form-label fw-bold" style="font-size: 12px;"></label>
                <input asp-for="ExperienceNotes" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label fw-bold" style="font-size: 13px;"></label>
                <textarea asp-for="ShortDescription" rows="3" class="form-control"></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Status" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<DailyHelpListingStatus>()" class="form-select"></select>
                </div>
                <div class="col-6">
                    <label asp-for="VerificationStatus" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <select asp-for="VerificationStatus" asp-items="Html.GetEnumSelectList<DailyHelpVerificationStatus>()" class="form-select"></select>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="AdminInternalNotes" class="form-label fw-bold" style="font-size: 12px;"></label>
                <input asp-for="AdminInternalNotes" class="form-control" />
            </div>

            <button type="submit" class="btn btn-dark w-100 py-2 fw-bold rounded-pill">
                Save Changes
            </button>
        </form>
    </div>
</div>