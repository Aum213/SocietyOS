@model SocietyOS.ViewModels.ResidentRecommendDailyHelpViewModel
@using SocietyOS.Models
@using SocietyOS.Controllers
@{
    ViewData["Title"] = "Recommend a Household Helper";
}

<div class="home-container" style="max-width: 580px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge bg-success mb-1" style="font-size: 10px;">COMMUNITY RECOMMENDATION</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Recommend a Helper</h2>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">Cancel</a>
    </div>

    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <div class="alert alert-light border py-2 px-3 mb-3" style="font-size: 12px;">
            🔒 Your recommendation will be reviewed by the Society Administrator before appearing in the directory. Your name and flat number will <strong>not</strong> be shown publicly.
        </div>

        <form asp-action="Recommend" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size: 13px;"></div>

            <div class="mb-3">
                <label asp-for="ProviderName" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="ProviderName" class="form-control" placeholder="e.g. Sunita Ben" />
                <span asp-validation-for="ProviderName" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Category" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <select asp-for="Category" class="form-select">
                        @foreach (var cat in Enum.GetValues<DailyHelpCategory>())
                        {
                            <option value="@cat">@DailyHelpController.FormatCategoryLabel(cat)</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label asp-for="ContactPhone" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <input asp-for="ContactPhone" class="form-control" placeholder="+91 98765 43210" />
                    <span asp-validation-for="ContactPhone" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="ServiceArea" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <input asp-for="ServiceArea" class="form-control" placeholder="e.g. Towers A & B" />
                </div>
                <div class="col-6">
                    <label asp-for="AvailabilityNotes" class="form-label fw-bold" style="font-size: 12px;"></label>
                    <input asp-for="AvailabilityNotes" class="form-control" placeholder="e.g. Afternoon 2 PM – 5 PM" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ExperienceNotes" class="form-label fw-bold" style="font-size: 12px;"></label>
                <input asp-for="ExperienceNotes" class="form-control" placeholder="e.g. Working in our flat for 2 years" />
            </div>

            <div class="mb-4">
                <label asp-for="ShortDescription" class="form-label fw-bold" style="font-size: 13px;"></label>
                <textarea asp-for="ShortDescription" rows="3" class="form-control" placeholder="Describe their work quality, punctuality, and specific tasks..."></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold rounded-pill" style="background: var(--sos-primary);">
                Submit for Admin Moderation
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}