@model SocietyOS.ViewModels.CreateIssueViewModel
@using SocietyOS.Models
@{
    ViewData["Title"] = "Report a Community Issue";
}

@section Styles {
    <link rel="stylesheet" href="~/css/societyos-home.css" asp-append-version="true" />
}

<div class="home-container" style="max-width: 580px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge bg-success mb-1" style="font-size: 10px;">ANONYMOUS TO NEIGHBOURS</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Report an Issue</h2>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: var(--sos-radius-full);">
            Cancel
        </a>
    </div>

    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size: 13px;"></div>

            <!-- 1. Title -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Lift #2 display panel flickering on 4th floor" />
                <span asp-validation-for="Title" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <!-- 2. Category & Location Scope -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Category" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<IssueCategory>()" class="form-select"></select>
                </div>
                <div class="col-6">
                    <label asp-for="LocationScope" class="form-label fw-bold" style="font-size: 13px;"></label>
                    <select asp-for="LocationScope" asp-items="Html.GetEnumSelectList<IssueLocationScope>()" class="form-select" id="scopeSelect"></select>
                </div>
            </div>

            <!-- 3. Conditional Location Fields -->
            <div id="buildingSelectWrap" class="mb-3">
                <label asp-for="BuildingId" class="form-label fw-bold" style="font-size: 13px;"></label>
                <select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select"></select>
                <span asp-validation-for="BuildingId" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div id="flatScopeHint" class="alert alert-light border py-2 px-3 mb-3" style="font-size: 12px; display: none;">
                🔒 Your verified flat (<strong>@Model.ResidentFlatDisplay</strong>) will be shared privately with Society Administrators for repair coordination, while appearing anonymously as <em>"Private Unit"</em> in the resident feed.
            </div>

            <div id="landmarkWrap" class="mb-3">
                <label asp-for="LocationDetails" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="LocationDetails" class="form-control" placeholder="e.g. Near Basement Pillar B4 / 3rd Floor Corridor" />
                <span asp-validation-for="LocationDetails" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <!-- 4. Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold" style="font-size: 13px;"></label>
                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe what happened, when it started, and any safety impact..."></textarea>
                <span asp-validation-for="Description" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <!-- 5. Optional Photo Upload -->
            <div class="mb-4">
                <label asp-for="Photo" class="form-label fw-bold" style="font-size: 13px;"></label>
                <input asp-for="Photo" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" capture="environment" id="issuePhotoInput" />
                <span asp-validation-for="Photo" class="text-danger" style="font-size: 12px;"></span>
                <div id="photoPreviewWrap" class="mt-2" style="display: none; height: 160px; border-radius: 12px; overflow: hidden; border: 1px solid var(--sos-border);">
                    <img id="photoPreviewImg" style="width: 100%; height: 100%; object-fit: cover;" alt="Selected issue preview" />
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="border-radius: var(--sos-radius-full); background: var(--sos-primary); border-color: var(--sos-primary);">
                Submit Issue Report
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const scopeSelect = document.getElementById('scopeSelect');
        const buildingWrap = document.getElementById('buildingSelectWrap');
        const flatHint = document.getElementById('flatScopeHint');
        const landmarkWrap = document.getElementById('landmarkWrap');

        function updateLocationVisibility() {
            const val = scopeSelect.value; // 0 = FlatSpecific, 1 = BuildingCommonArea, 2 = CommunityWide
            if (val === "0") {
                buildingWrap.style.display = "none";
                flatHint.style.display = "block";
                landmarkWrap.style.display = "none";
            } else if (val === "1") {
                buildingWrap.style.display = "block";
                flatHint.style.display = "none";
                landmarkWrap.style.display = "block";
            } else {
                buildingWrap.style.display = "none";
                flatHint.style.display = "none";
                landmarkWrap.style.display = "block";
            }
        }

        scopeSelect.addEventListener('change', updateLocationVisibility);
        updateLocationVisibility();

        const photoInput = document.getElementById('issuePhotoInput');
        const previewWrap = document.getElementById('photoPreviewWrap');
        const previewImg = document.getElementById('photoPreviewImg');

        photoInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewWrap.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                previewWrap.style.display = 'none';
            }
        });
    </script>
}