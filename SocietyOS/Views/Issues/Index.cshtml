@model SocietyOS.ViewModels.IssueFeedViewModel
@using SocietyOS.Models
@{
    ViewData["Title"] = "Community Issues";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

@section Styles {
    <link rel="stylesheet" href="~/css/societyos-home.css" asp-append-version="true" />
    <style>
        .issue-card {
            background: #ffffff;
            border: 1px solid var(--sos-border);
            border-radius: var(--sos-radius-lg);
            padding: 16px;
            box-shadow: var(--sos-shadow-card);
            margin-bottom: 14px;
            transition: border-color 0.15s ease;
        }
        .issue-card:hover {
            border-color: #cbd5e1;
        }
        .vote-pill-group {
            display: inline-flex;
            align-items: center;
            background: #f8faf9;
            border: 1px solid var(--sos-border);
            border-radius: var(--sos-radius-full);
            padding: 2px 6px;
            gap: 4px;
        }
        .vote-btn {
            border: none;
            background: transparent;
            padding: 4px 8px;
            border-radius: var(--sos-radius-full);
            font-size: 13px;
            font-weight: 700;
            color: var(--sos-text-secondary);
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .vote-btn.active-up {
            background: rgba(30, 77, 56, 0.12);
            color: var(--sos-primary);
        }
        .vote-btn.active-down {
            background: var(--sos-danger-soft);
            color: var(--sos-danger);
        }
        .status-badge-Reported { background: #fef3c7; color: #92400e; }
        .status-badge-Verified { background: #e0f2fe; color: #075985; }
        .status-badge-InProgress { background: #ede9fe; color: #5b21b6; }
        .status-badge-Resolved { background: #dcfce7; color: #166534; }
    </style>
}

<div class="home-container" style="max-width: 680px;">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge bg-success mb-1" style="font-size: 10px; letter-spacing: 0.5px;">COMMUNITY VOICE</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Community Issues</h2>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Admin" class="btn btn-sm btn-outline-dark fw-semibold" style="border-radius: var(--sos-radius-full);">
                    Admin Console
                </a>
            }
            <a asp-action="Create" class="btn btn-sm btn-success fw-bold px-3" style="border-radius: var(--sos-radius-full); background: var(--sos-primary); border-color: var(--sos-primary);">
                + Report Issue
            </a>
        </div>
    </div>

    <!-- Filter & Sort Controls -->
    <form method="get" asp-action="Index" class="bg-white border rounded-4 p-3 mb-3 shadow-sm">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-sm-4">
                <label for="statusFilter" class="form-label text-muted fw-semibold mb-1" style="font-size: 11px;">STATUS</label>
                <select id="statusFilter" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var st in Enum.GetValues<IssueStatus>())
                    {
                        <option value="@st" selected="@(Model.SelectedStatus == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-6 col-sm-4">
                <label for="categoryFilter" class="form-label text-muted fw-semibold mb-1" style="font-size: 11px;">CATEGORY</label>
                <select id="categoryFilter" name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Enum.GetValues<IssueCategory>())
                    {
                        <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-4">
                <label for="sortFilter" class="form-label text-muted fw-semibold mb-1" style="font-size: 11px;">RANK BY</label>
                <select id="sortFilter" name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="most-voted" selected="@(Model.SortBy == "most-voted")">Most Voted (Priority)</option>
                    <option value="recent" selected="@(Model.SortBy == "recent")">Most Recent</option>
                </select>
            </div>
        </div>
    </form>

    <!-- Issue Cards -->
    @if (!Model.Issues.Any())
    {
        <div class="text-center bg-white border rounded-4 p-5">
            <div style="font-size: 36px; margin-bottom: 8px;">🛠️</div>
            <h5 class="fw-bold mb-1">No Matching Issues Found</h5>
            <p class="text-muted mb-3" style="font-size: 13px;">
                No community problems match your current filter criteria.
            </p>
            <a asp-action="Create" class="btn btn-sm btn-success px-4 py-2 fw-bold" style="border-radius: var(--sos-radius-full); background: var(--sos-primary);">
                Report a Society Problem
            </a>
        </div>
    }
    else
    {
        @foreach (var item in Model.Issues)
        {
            <article class="issue-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <span class="badge rounded-pill status-badge-@item.Status" style="font-size: 11px; font-weight: 700;">
                            @item.Status
                        </span>
                        <span class="badge bg-light text-secondary border" style="font-size: 11px;">
                            @item.Category
                        </span>
                        @if (item.HasPhoto)
                        {
                            <span class="badge bg-light text-dark border" style="font-size: 11px;" title="Photo attached">📷 Photo</span>
                        }
                    </div>
                    <small class="text-muted" style="font-size: 11px; white-space: nowrap;">
                        @item.CreatedAtUtc.ToString("dd MMM")
                    </small>
                </div>

                <h3 class="h6 fw-bold mb-1">
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none" style="color: var(--sos-text-primary);">
                        @item.Title
                    </a>
                </h3>

                <p class="text-muted mb-2" style="font-size: 13px; line-height: 1.45;">
                    @item.DescriptionSnippet
                </p>

                <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
                    <!-- Anonymous Privacy-Safe Location & Reporter -->
                    <div class="text-muted" style="font-size: 11px;">
                        <span>📍 @item.PrivacySafeLocation</span>
                        <span class="mx-1">•</span>
                        <span>By Resident</span>
                    </div>

                    <!-- Voting & Comment Bar -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="vote-pill-group" role="group" aria-label="Vote on issue">
                            <form asp-action="Vote" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="IssueId" value="@item.Id" />
                                <input type="hidden" name="VoteValue" value="1" />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="vote-btn @(item.CurrentUserVote == 1 ? "active-up" : "")" aria-label="Upvote issue" title="Upvote">
                                    ▲ @item.Upvotes
                                </button>
                            </form>

                            <span class="fw-bold px-1" style="font-size: 12px; color: var(--sos-primary);">
                                @(item.NetVotes >= 0 ? $"+{item.NetVotes}" : item.NetVotes.ToString())
                            </span>

                            <form asp-action="Vote" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="IssueId" value="@item.Id" />
                                <input type="hidden" name="VoteValue" value="-1" />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="vote-btn @(item.CurrentUserVote == -1 ? "active-down" : "")" aria-label="Downvote issue" title="Downvote">
                                    ▼
                                </button>
                            </form>
                        </div>

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-2 py-1" style="font-size: 12px;" aria-label="View @item.CommentCount comments">
                            💬 @item.CommentCount
                        </a>
                    </div>
                </div>
            </article>
        }

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Issue feed pages" class="d-flex justify-content-center gap-2 my-3">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <a asp-action="Index"
                       asp-route-status="@Model.SelectedStatus"
                       asp-route-category="@Model.SelectedCategory"
                       asp-route-sort="@Model.SortBy"
                       asp-route-page="@p"
                       class="btn btn-sm @(p == Model.CurrentPage ? "btn-success" : "btn-outline-secondary") rounded-pill px-3">
                        @p
                    </a>
                }
            </nav>
        }
    }
</div>

