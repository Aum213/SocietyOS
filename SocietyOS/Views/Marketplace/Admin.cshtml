@model SocietyOS.ViewModels.AdminMarketplaceIndexViewModel
@using SocietyOS.Models
@{
    ViewData["Title"] = "Marketplace Moderation Console";
}

<div class="home-container" style="max-width: 820px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge bg-dark mb-1" style="font-size: 10px;">ADMINISTRATION</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Marketplace Moderation</h2>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">Public Feed</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3" style="font-size: 13px;">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Admin" class="btn btn-sm @(!Model.SelectedStatus.HasValue && !Model.FlaggedOnly ? "btn-dark" : "btn-outline-secondary") rounded-pill">All</a>
        <a asp-action="Admin" asp-route-status="@MarketplaceListingStatus.PendingApproval" class="btn btn-sm @(Model.SelectedStatus == MarketplaceListingStatus.PendingApproval ? "btn-warning text-dark" : "btn-outline-warning text-dark") rounded-pill fw-bold">
            Pending Approval (@Model.PendingCount)
        </a>
        <a asp-action="Admin" asp-route-status="@MarketplaceListingStatus.Active" class="btn btn-sm @(Model.SelectedStatus == MarketplaceListingStatus.Active ? "btn-success" : "btn-outline-success") rounded-pill">
            Active (@Model.ActiveCount)
        </a>
        <a asp-action="Admin" asp-route-flaggedOnly="true" class="btn btn-sm @(Model.FlaggedOnly ? "btn-danger" : "btn-outline-danger") rounded-pill">
            Reported / Flagged (@Model.FlaggedCount)
        </a>
    </div>

    @foreach (var item in Model.Listings)
    {
        <div class="bg-white border rounded-4 p-3 mb-2 shadow-sm">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                <div>
                    <span class="badge @(item.Status == MarketplaceListingStatus.Active ? "bg-success" : item.Status == MarketplaceListingStatus.PendingApproval ? "bg-warning text-dark" : "bg-secondary") me-1" style="font-size: 10px;">
                        @item.Status
                    </span>
                    <strong style="font-size: 15px;">@item.Title</strong> — <span class="fw-bold">@item.PriceDisplay</span>
                    @if (item.ReportCount > 0)
                    {
                        <span class="badge bg-danger ms-1" style="font-size: 10px;">🚩 @item.ReportCount Report(s)</span>
                    }
                </div>
                <small class="text-muted" style="font-size: 11px;">Seller: <strong>@item.SellerInternalDisplay</strong></small>
            </div>

            <p class="text-muted mb-2" style="font-size: 12px;">@item.DescriptionSnippet</p>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3" style="font-size: 11px;">Inspect</a>

                @if (item.Status != MarketplaceListingStatus.Active)
                {
                    <form asp-action="Moderate" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="targetStatus" value="@MarketplaceListingStatus.Active" />
                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" style="font-size: 11px;">Approve & Publish</button>
                    </form>
                }

                @if (item.Status == MarketplaceListingStatus.PendingApproval)
                {
                    <form asp-action="Moderate" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="targetStatus" value="@MarketplaceListingStatus.Rejected" />
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" style="font-size: 11px;">Reject</button>
                    </form>
                }

                @if (item.Status == MarketplaceListingStatus.Active)
                {
                    <form asp-action="Moderate" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="targetStatus" value="@MarketplaceListingStatus.Withdrawn" />
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" style="font-size: 11px;">Withdraw Listing</button>
                    </form>
                }
            </div>
        </div>
    }
</div>