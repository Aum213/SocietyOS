@model SocietyOS.ViewModels.AdminAnnouncementIndexViewModel
@using SocietyOS.Models
@{
    ViewData["Title"] = "Manage Announcements";
}

@section Styles {
    <link rel="stylesheet" href="~/css/societyos-home.css" asp-append-version="true" />
}

<div class="home-container" style="max-width: 820px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <span class="badge bg-dark mb-1" style="font-size: 10px;">ADMINISTRATION</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Manage Announcements</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">Resident Feed</a>
            <a asp-action="Create" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" style="background: var(--sos-primary);">
                + New Announcement
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3" style="font-size: 13px;">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 13px;">@TempData["ErrorMessage"]</div>
    }

    <!-- Summary Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Admin" class="btn btn-sm @(!Model.SelectedState.HasValue ? "btn-dark" : "btn-outline-secondary") rounded-pill">
            All
        </a>
        <a asp-action="Admin" asp-route-state="@AnnouncementState.Published" class="btn btn-sm @(Model.SelectedState == AnnouncementState.Published ? "btn-success" : "btn-outline-success") rounded-pill">
            Published (@Model.PublishedActiveCount Active)
        </a>
        <a asp-action="Admin" asp-route-state="@AnnouncementState.Draft" class="btn btn-sm @(Model.SelectedState == AnnouncementState.Draft ? "btn-warning text-dark" : "btn-outline-secondary") rounded-pill">
            Drafts (@Model.DraftCount)
        </a>
        <a asp-action="Admin" asp-route-state="@AnnouncementState.Archived" class="btn btn-sm @(Model.SelectedState == AnnouncementState.Archived ? "btn-secondary" : "btn-outline-secondary") rounded-pill">
            Archived (@Model.ArchivedCount)
        </a>
    </div>

    <!-- Search & Category Filter -->
    <form method="get" asp-action="Admin" class="bg-white border rounded-4 p-3 mb-3 shadow-sm">
        <input type="hidden" name="state" value="@Model.SelectedState" />
        <div class="row g-2">
            <div class="col-12 col-sm-6">
                <input type="search" name="q" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="Search title or body..." />
            </div>
            <div class="col-8 col-sm-4">
                <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Enum.GetValues<AnnouncementCategory>())
                    {
                        <option value="@cat" selected="@(Model.SelectedCategory == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-4 col-sm-2">
                <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
            </div>
        </div>
    </form>

    @if (!Model.Announcements.Any())
    {
        <div class="text-center bg-white border rounded-4 p-5">
            <h5 class="fw-bold mb-1">No Announcements Found</h5>
            <p class="text-muted mb-3" style="font-size: 13px;">Create a draft or publish a new notice to inform residents.</p>
            <a asp-action="Create" class="btn btn-sm btn-success rounded-pill px-4 fw-bold" style="background: var(--sos-primary);">
                Create First Announcement
            </a>
        </div>
    }
    else
    {
        @foreach (var item in Model.Announcements)
        {
            <div class="bg-white border rounded-4 p-3 mb-2 shadow-sm">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <span class="badge @(item.State == AnnouncementState.Published ? "bg-success" : item.State == AnnouncementState.Draft ? "bg-warning text-dark" : "bg-secondary")" style="font-size: 10px;">
                            @item.State
                        </span>
                        @if (item.IsExpired)
                        {
                            <span class="badge bg-danger" style="font-size: 10px;">EXPIRED</span>
                        }
                        @if (item.IsPinned)
                        {
                            <span class="badge bg-dark" style="font-size: 10px;">📌 Pinned</span>
                        }
                        <span class="badge bg-light text-dark border" style="font-size: 10px;">@item.Priority Priority</span>
                        <span class="badge bg-light text-secondary border" style="font-size: 10px;">@item.Category</span>
                    </div>
                    <small class="text-muted" style="font-size: 11px;">
                        Reads: <strong>@item.ReadCount</strong> • Updated @item.UpdatedAtUtc.ToString("dd MMM HH:mm") UTC
                    </small>
                </div>

                <h4 class="h6 fw-bold mb-1">
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Title</a>
                </h4>
                <p class="text-muted mb-2" style="font-size: 12px;">@item.ContentSnippet</p>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                    <div class="d-flex flex-wrap gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3" style="font-size: 11px;">
                            Edit
                        </a>

                        @if (item.State == AnnouncementState.Published)
                        {
                            <form asp-action="TogglePin" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="font-size: 11px;">
                                    @(item.IsPinned ? "Unpin" : "Pin to Top")
                                </button>
                            </form>

                            <form asp-action="ChangeState" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="targetAction" value="Unpublish" />
                                <button type="submit" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3" style="font-size: 11px;">
                                    Unpublish
                                </button>
                            </form>
                        }

                        @if (item.State == AnnouncementState.Draft)
                        {
                            <form asp-action="ChangeState" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="targetAction" value="Publish" />
                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" style="font-size: 11px;">
                                    Publish Now
                                </button>
                            </form>
                        }

                        @if (item.State != AnnouncementState.Archived)
                        {
                            <form asp-action="ChangeState" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="targetAction" value="Archive" />
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" style="font-size: 11px;">
                                    Archive
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="ChangeState" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="targetAction" value="Restore" />
                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size: 11px;">
                                    Restore to Draft
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>