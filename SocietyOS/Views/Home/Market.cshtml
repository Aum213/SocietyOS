@{
    ViewData["Title"] = "Resident Marketplace";
}

<div class="home-container" style="max-width: 600px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <span class="badge bg-secondary mb-1" style="font-size: 10px; letter-spacing: 0.5px;">PLANNED MODULE</span>
            <h2 class="m-0 fw-bold" style="font-size: 22px;">Resident Marketplace</h2>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
            Home
        </a>
    </div>

    <div class="bg-white border rounded-4 p-4 shadow-sm text-center mb-3">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(30, 77, 56, 0.1); color: var(--sos-primary); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
        </div>

        <h3 class="h5 fw-bold mb-2">Peer-to-Peer Community Exchange</h3>
        <p class="text-muted mb-3" style="font-size: 13px; line-height: 1.55;">
            The SocietyOS Resident Marketplace is scheduled for an upcoming phase. It will let verified residents across Towers A, B, C, and D buy, sell, donate, or lend pre-owned household items, books, bicycles, and appliances safely within the gated community.
        </p>

        <div class="row g-2 text-start mb-4" style="font-size: 12px;">
            <div class="col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <strong class="d-block mb-1 text-dark">✓ Verified Neighbours Only</strong>
                    <span class="text-muted">Listings restricted strictly to verified flat owners and tenants.</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <strong class="d-block mb-1 text-dark">✓ Zero External Spam</strong>
                    <span class="text-muted">No outside brokers or unverified third-party advertisements.</span>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-controller="Announcements" asp-action="Index" class="btn btn-sm btn-success rounded-pill px-4 fw-bold" style="background: var(--sos-primary);">
                Browse Notice Board
            </a>
            <a asp-controller="Issues" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-4">
                View Community Issues
            </a>
        </div>
    </div>
</div>